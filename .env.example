# Docker Web: run docker compose from the workspace root.
COMPOSE_PROJECT_NAME=city-bloxx-web
NODE_IMAGE=node:22-bookworm-slim
WEB_IMAGE=city-bloxx-web:local
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=56789
PORT=3000
HOSTNAME=0.0.0.0
WEB_RESTART_POLICY=unless-stopped
WEB_HEALTH_INTERVAL=30s
WEB_HEALTH_TIMEOUT=5s
WEB_HEALTH_START_PERIOD=30s
WEB_HEALTH_RETRIES=3
# Public values are baked into the client. Rebuild after changing.
NEXT_PUBLIC_SITE_URL=http://localhost:56789/
NEXT_PUBLIC_SITE_NAME="City Bloxx Online"
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_PRIMARY_COLOR=
