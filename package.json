{
  "name": "city-bloxx-workspace",
  "version": "0.2.0",
  "private": true,
  "allowScripts": { "esbuild@0.25.12": true },
  "workspaces": ["packages/*", "base-game-nextjs", "base-playable-main"],
  "scripts": {
    "assets:export": "node scripts/export-game-assets.cjs",
    "assets:check": "node scripts/check-game-assets.cjs",
    "test": "npm --prefix base-game-nextjs test",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test:web": "node scripts/browser-smoke.cjs --web-only",
    "evidence:web": "node scripts/web-evidence.cjs",
    "evidence:w1": "node scripts/w1-infrastructure-evidence.cjs",
    "evidence:auth": "node scripts/w1-infrastructure-evidence.cjs --auth-browser",
    "evidence:cloud": "node scripts/w1-infrastructure-evidence.cjs --cloud-browser",
    "evidence:ranked": "node scripts/w1-infrastructure-evidence.cjs --ranked-browser",
    "evidence:w1:full": "node scripts/w1-infrastructure-evidence.cjs --all-browser",
    "evidence:playable": "node scripts/playable-y0-y2-evidence.cjs",
    "evidence:soft-launch": "node scripts/soft-launch-evidence.cjs",
    "test:save": "node scripts/c4-save-evidence.cjs",
    "test:daily": "node scripts/daily-evidence.cjs",
    "test:progression": "node scripts/progression-evidence.cjs",
    "test:cosmetics": "node scripts/cosmetics-evidence.cjs",
    "evidence:c5": "node scripts/c5-districts-evidence.cjs",
    "lint": "npm --prefix base-game-nextjs run lint",
    "build:web": "npm run assets:check && npm --prefix base-game-nextjs run build",
    "build:playable": "npm run assets:check && npm --prefix base-playable-main run package",
    "build": "npm run build:web && npm run build:playable",
    "check": "npm run assets:check && npm test && npm run lint && npm run build",
    "dev:web": "npm --prefix base-game-nextjs run dev",
    "dev:playable": "npm --prefix base-playable-main run dev"
  }
}
