# Copy file nay thanh .env roi sua theo may cua ban.
# Moi thu deu doc tu env, khong hardcode port trong code.

# Port ben trong container (nginx listen)
CONTAINER_PORT=80
# Port map ra may host -> mo http://localhost:HOST_PORT
HOST_PORT=8080

# Port cua `npm run dev` (Vite dev server)
DEV_PORT=3000
# Port cua `npm run preview` (dung cai nay de test voi Test Suite)
PREVIEW_PORT=4173

# ---- Build-time config (VITE_* -> doc qua import.meta.env trong src/platform/config.ts) ----
# Ten hien thi cua game
VITE_GAME_NAME=City Bloxx Online
# Key luu tru (doi khi fork sang game moi de tranh dung save cu)
VITE_SAVE_KEY=city_bloxx_save_v1
# Phien ban save: tang len khi doi cau truc du lieu luu
VITE_SAVE_VERSION=1
# Cac rewardId cho quang cao thuong (moi game dang ky rieng tren Developer Portal)
VITE_REWARD_EXTRA_TIME=extra_time

# ---- Docker ----
IMAGE_NAME=base-playable
IMAGE_TAG=latest
CONTAINER_NAME=base-playable
RESTART_POLICY=unless-stopped
