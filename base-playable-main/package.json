{
  "name": "base-playable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "YouTube Playables base template - all SDK requirements pre-wired, just write your game.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../scripts/check-game-assets.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-package.mjs",
    "zip": "node scripts/zip-dist.mjs",
    "package": "npm run typecheck && npm run build && npm run check && npm run zip"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
