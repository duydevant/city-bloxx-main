# App
APP_NAME=
APP_PORT=
APP_TRUST_PROXY=true
TZ=UTC
NODE_ENV=local
FRONTEND_ADMIN_PORTAL_URL=
FRONTEND_USER_PORTAL_URL=
APP_URL=

# Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_CONNECTION=
DB_DATABASE=
DB_SCHEMA=

# Jwt
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=base-nest-bo-minh
JWT_AUDIENCE=base-nest-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_ACTIVE_SESSIONS=10
PASSWORD_MIN_LENGTH=12
REGISTRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true
AUTH_ALLOWED_ORIGINS=http://localhost:31005,http://localhost:3000
# Optional City Bloxx gateway overlay (docker-compose.game.yml)
GAME_WEB_PORT=56789
# Dedicated 32-byte base64 AES key; required to issue ranked tickets. Never reuse JWT/mail keys.
GAME_TICKET_ENCRYPTION_KEY=
GAME_TICKET_KEY_ID=
# JSON object of retained key IDs to base64 keys; retain old keys for outstanding 24-hour tickets.
GAME_TICKET_DECRYPTION_KEYS={}
# Pause automatic dispatch for maintenance; persisted jobs remain queued.
GAME_VERIFICATION_ENABLED=true
GAME_PUBLIC_URL=http://localhost:56789
GAME_AUTH_ALLOWED_ORIGINS=http://localhost:56789,http://127.0.0.1:56789,http://localhost:3000,http://localhost:31005
COOKIE_SECURE=false
# 32-byte AES key, hex encoded; never commit a real value.
MAIL_OUTBOX_KEY=
# Optional operator-provisioned admin. Configure BOTH; no fixed password is shipped.
# First seed creates an active, verified account with user + admin roles.
# Subsequent seeds preserve credentials, status and roles; not a password reset mechanism.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
JWT_ACCESS_TOKEN_EXPIRES_IN=
JWT_REFRESH_TOKEN_EXPIRES_IN=

# Redis
REDIS_URL=

# Google Auth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AWS SES (Optional)
AWS_SES_SENDER=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_ACCESS_SECRET_ACCESS_KEY=

AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_CREDENTIALS_REQUIRED=false
CLOUDFRONT_URL=

# ms
OTP_COOLDOWN=10000

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_SECURE=true
